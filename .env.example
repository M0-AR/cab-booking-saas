# CabDesk environment — copy to .env and replace every CHANGE_ME value.
# `make init` does this for you and fills in random secrets.
#
# Generate secrets with:  openssl rand -hex 32

# Deployment environment ("prod" in containers).
ENV=prod

# Postgres superuser password (used by migrations; CHANGE_ME).
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Password for the restricted application role (RLS-enforced; CHANGE_ME).
APP_DB_PASSWORD=CHANGE_ME_app_password

# Secret used to sign JWTs — changing it logs everybody out (CHANGE_ME).
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars

# Address Caddy listens on.
#   ":80"                 -> plain HTTP on port 80 (local / behind another LB)
#   "bookings.acme.com"   -> automatic HTTPS via Let's Encrypt
SITE_ADDRESS=:80

# Base domain used to link tenant workspaces (informational).
PLATFORM_BASE_DOMAIN=localhost

# Comma-separated allowed browser origins (only needed if you call the API
# from another origin; same-origin via Caddy needs no CORS).
CORS_ORIGINS=http://localhost

# API worker processes (roughly 2 per CPU core).
WEB_CONCURRENCY=4
