{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API goes to the FastAPI backend.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Health endpoints stay reachable for uptime monitors.
	handle /livez {
		reverse_proxy api:8000
	}
	handle /readyz {
		reverse_proxy api:8000
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
